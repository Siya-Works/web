{
  "name": "siya-works",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/validate.ts && next build --webpack && tsx scripts/ads-txt.ts",
    "start": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out",
    "typecheck": "tsc --noEmit",
